# Copy to .env locally. Never commit .env.
APP_ENV=development
MOCK_MODE=true
API_KEY=replace-with-a-long-random-value
TELEGRAM_BOT_TOKEN=
# Generate a separate random value for Telegram's webhook secret header.
TELEGRAM_WEBHOOK_SECRET=
# Keep empty until the Mini App is hosted at a real HTTPS URL.
MINI_APP_URL=
# Telegram initData expires after one hour; reopen the Mini App for fresh data.
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-a-generated-fernet-key
# SQLite is suitable for local development only unless the host provides persistent storage.
# For production, use a managed PostgreSQL URL or a host-attached persistent volume.
DATABASE_URL=sqlite:///./rma_backend.db

# Required only when MOCK_MODE=false. These must identify a real, preconfigured server.
WG_INTERFACE=wg0
WG_SERVER_ENDPOINT=
WG_SERVER_PUBLIC_KEY=
WG_SUBNET=10.66.66.0/24
WG_DNS=1.1.1.1,8.8.8.8
WG_MTU=1360

# Set only on the API and trusted VPN metering agent; never expose to clients.
METERING_SHARED_SECRET=
