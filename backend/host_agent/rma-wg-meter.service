[Unit]
Description=R&MA trusted WireGuard traffic metering and quota enforcement
Wants=network-online.target
After=network-online.target wg-quick@wg0.service

[Service]
Type=simple
User=rma-meter
Group=rma-meter
EnvironmentFile=/etc/rma/metering.env
ExecStart=/usr/bin/python3 /opt/rma/host_agent/rma_wg_meter.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rma-meter
ReadOnlyPaths=/etc/rma/peers.json
LockPersonality=true
MemoryDenyWriteExecute=true

# Grant this account only the host-specific permissions needed for wg show
# and wg set peer removal. Do not make it generally privileged.

[Install]
WantedBy=multi-user.target
