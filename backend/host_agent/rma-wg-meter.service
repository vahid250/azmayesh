[Unit]
Description=R&MA trusted WireGuard traffic metering and quota enforcement
Wants=network-online.target nftables.service
After=network-online.target nftables.service wg-quick@wg0.service

[Service]
Type=simple
User=rma-meter
Group=rma-meter
EnvironmentFile=/etc/rma/metering.env
ExecStart=/usr/bin/python3 /opt/rma/host_agent/rma_wg_meter.py
Restart=on-failure
RestartSec=5
UMask=0077
StateDirectory=rma-meter
StateDirectoryMode=0700
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rma-meter
LockPersonality=true
MemoryDenyWriteExecute=true

# Grant this account only the host-specific permissions needed for wg show
# and wg set peer registration/removal. Do not make it generally privileged.

[Install]
WantedBy=multi-user.target
